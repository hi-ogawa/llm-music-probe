# ---------------------------------------------------------------------------------------------
# Chorus C: the shout. Everyone plays the same rhythm, lead trumpet high.
# - Trumpets: 4-way close under a lead that climbs from D6 to F6 (written G6) at bars 3, 8, 11.
#   Blue-note colour comes from the lead line itself (D6 C6 Db6 into the IV chord, E6 into G7).
#   Pushes that tie over a bar line are voiced as the chord they land on (bar 1 ends on Eb7, bar 3 on Fm7,
#   bar 5 on Edim7), so the anticipation sounds like a push and not a clash.
# - Altos and tenors double the trumpet voicing an octave down for weight; the bari leaves the lead and plays
#   roots with the bottom trombone, so the ensemble has a solid floor.
# - Trombones: same rhythm as the trumpets with fixed spread voicings per chord, except bars 5-8, where they
#   break off into backbeat punches on 2 and 4 against the trumpet and sax figure. That is the one place in
#   the shout where the sections argue instead of agreeing, which keeps the chorus from being a single block.
# - The piano lays out, as a Basie-style piano would under a full shout. Snare and kick catch the ensemble
#   hits, and the crash marks bars 1 and 9 and the F6 peak in bar 11.
# ---------------------------------------------------------------------------------------------
pattern shout
tpt   | D6+Bb5+Ab5+F5--! . D6+Bb5+Ab5+F5 C6+Ab5+F5+D5 Db6+Bb5+G5+F5-! | - . Db6+Bb5+G5+F5 . Bb5+G5+F5+Db5 C6+G5+F5+Db5 Db6+Bb5+G5+F5-! | D6+Bb5+Ab5+F5--! . F6+D6+C6+Ab5 Eb6+C6+Ab5+F5 C6+Ab5+F5+Eb5-! | - . C6+Ab5+F5+Eb5 Ab5+F5+Eb5+C5 D6+Bb5+Ab5+F5--! . |
tpt   | Db6+Bb5+G5+F5-! . Db6+Bb5+G5+F5 . Bb5+G5+F5+Db5 C6+G5+F5+Db5 Db6+Bb5+G5+E5 | - Bb5+G5+E5+Db5 Db6+Bb5+G5+E5 E6+Db6+Bb5+G5-! Db6+Bb5+G5+E5 Bb5+G5+E5+Db5 . | D6+Bb5+Ab5+F5--! . D6+Bb5+Ab5+F5 . Eb6+C6+Ab5+F5 E6+Db6+Bb5+G5 | F6+D6+B5+Ab5--! . D6+B5+Ab5+F5 . B5+Ab5+F5+D5 Ab5+F5+D5+B4 |
tpt   | Eb6+C6+Bb5+G5---! D6+Bb5+G5+Eb5 C6+Bb5+G5+Eb5 Bb5+G5+Eb5+C5 G5+Eb5+D5+Bb4 | A5+F5+Eb5+C5- C6+A5+G5+Eb5 Eb6+C6+A5+G5-! . D6+A5+G5+Eb5 C6+A5+G5+Eb5 | D6+Bb5+Ab5+F5--! . F6+D6+B5+Ab5---! | Eb6+C6+Bb5+G5--! . Eb6+C6+A5+G5-! .- |
tbn   | Bb2+F3+Ab3+D4--! . Bb2+F3+Ab3+D4 Bb2+F3+Ab3+D4 Eb3+G3+Bb3+Db4-! | - . Eb3+G3+Bb3+Db4 . Eb3+G3+Bb3+Db4 Eb3+G3+Bb3+Db4 Eb3+G3+Bb3+Db4-! | Bb2+F3+Ab3+D4--! . Bb2+F3+Ab3+D4 Bb2+F3+Ab3+D4 F2+Eb3+Ab3+C4-! | - . F2+Eb3+Ab3+C4 F2+Eb3+Ab3+C4 Bb2+F3+Ab3+D4--! . |
tbn   | .- Eb3+G3+Bb3+Db4-! .- Eb3+G3+Bb3+Db4- | .- E3+G3+Bb3+Db4-! .- E3+G3+Bb3+Db4- | .- Bb2+F3+Ab3+D4-! .- Bb2+F3+Ab3+D4- | .- G2+F3+Ab3+B3-! .- G2+F3+Ab3+B3- |
tbn   | C3+G3+Bb3+Eb4---! C3+G3+Bb3+Eb4 C3+G3+Bb3+Eb4 C3+G3+Bb3+Eb4 C3+G3+Bb3+Eb4 | F2+Eb3+A3+D4- F2+Eb3+A3+D4 F2+Eb3+A3+D4-! . F2+Eb3+A3+D4 F2+Eb3+A3+D4 | Bb2+F3+Ab3+D4--! . G2+F3+Ab3+B3---! | C3+G3+Bb3+Eb4--! . F2+Eb3+A3+D4-! .- |
alto  | D5+Bb4--! . D5+Bb4 C5+Ab4 Db5+Bb4-! | - . Db5+Bb4 . Bb4+G4 C5+G4 Db5+Bb4-! | D5+Bb4--! . F5+D5 Eb5+C5 C5+Ab4-! | - . C5+Ab4 Ab4+F4 D5+Bb4--! . |
alto  | Db5+Bb4-! . Db5+Bb4 . Bb4+G4 C5+G4 Db5+Bb4 | - Bb4+G4 Db5+Bb4 E5+Db5-! Db5+Bb4 Bb4+G4 . | D5+Bb4--! . D5+Bb4 . Eb5+C5 E5+Db5 | F5+D5--! . D5+B4 . B4+Ab4 Ab4+F4 |
