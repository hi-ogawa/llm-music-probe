tpt   | .- D6+Bb5+G5+Eb5-! .--- | _ | .- D6+Bb5+Ab5+F5-! .--- | .----- C6+A5+G5+Eb5 Eb6+C6+A5+G5! |
tbn   | .- Bb2+F3+Ab3+D4-----? | Eb3+G3+Bb3+Db4---? .--- | .- Bb2+F3+Ab3+D4-----? | F2+Eb3+Ab3+C4---? Bb2+F3+Ab3+D4---? |
tbn   | .- Eb3+G3+Bb3+Db4-----? | E3+G3+Bb3+Db4---? .--- | .- Bb2+F3+Ab3+D4-----? | G2+F3+Ab3+B3---? .--- |
tbn   | .- C3+G3+Bb3+Eb4-----? | F2+Eb3+A3+D4---? .--- | Bb2+F3+Ab3+D4---? G2+F3+Ab3+B3---? | C3+G3+Bb3+Eb4---? F2+Eb3+A3+D4---! |
piano | . Ab3+C4+D4+G4 .--- Ab3+C4+D4+G4- | . G3+C4+Db4+F4 .--- G3+C4+Db4+F4- | . Ab3+C4+D4+G4 .--- Ab3+C4+D4+G4- | . Ab3+C4+Eb4+G4 .- . Ab3+C4+D4+G4 .- |
