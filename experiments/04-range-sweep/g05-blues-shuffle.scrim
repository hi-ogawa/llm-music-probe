title    Twelve Eight Shuffle in A
composer Claude
about    A 12-bar blues shuffle in A with a quick change, a boogie bass, a 5-6 guitar shuffle riff, and rootless piano stabs.
tempo    110     # counts dotted quarters, so 110 shuffle beats per minute
beats    4       # four dotted-quarter beats per bar
steps    3       # three triplet eighths per beat, which gives 12/8
# Swing is unused because it needs an even step count. The shuffle is written
# directly on the triplet grid instead: almost every figure is long-short, a
# two-step note followed by a one-step note, which is the 12/8 shuffle feel.

# Bass: electric bass playing the classic boogie arpeggio 1-3-5-6-b7-6-5-3,
# one long-short pair per beat, so it both walks and states the shuffle.
voice bass   ebass  vol=1.0 gate=0.9
# Guitar: clean electric playing the 5-6-b7-6 power-chord shuffle, rooted on
# the open A, D, and low E strings. It locks with the bass rhythm, gated short
# so the long-short pulse stays crisp and the root stays one octave above the bass.
voice gtr    eguitar vol=0.75 pan=-0.35 gate=0.7
# Piano: rootless 9th-chord stabs (3-b7-9 on A, b7-3-5 on D and E) on the
# backbeats with a soft triplet pickup. The voicings move by half steps
# (C#-G-B to C-F#-A to D-G#-B) so the chord changes are audible but smooth.
voice keys   piano  vol=0.6 pan=0.35 gate=0.55

# Drums: ride plays the shuffle pattern (long-short on every beat), hat foot
# and snare mark 2 and 4, ghost snares on the last triplet push the swing,
# and the kick holds 1 and 3.
voice ride   ride   vol=0.7
voice hat    hat    vol=0.5
voice snare  snare  vol=0.8
voice kick   kick   vol=0.9
voice crash  crash  vol=0.6

# One chorus: A7 D7 A7 A7 | D7 D7 A7 A7 | E7 D7 A7 E7 (quick change, turnaround on V).
pattern chorus
bass  | A1- C#2 E2- F#2 G2- F#2 E2- C#2 | D2- F#2 A2- B2 C3- B2 A2- F#2 | A1- C#2 E2- F#2 G2- F#2 E2- C#2 | % |
bass  | D2- F#2 A2- B2 C3- B2 A2- F#2 | % | A1- C#2 E2- F#2 G2- F#2 E2- C#2 | % |
bass  | E1- G#1 B1- C#2 D2- C#2 B1- G#1 | D2- F#2 A2- B2 C3- B2 A2- F#2 | A1- C#2 E2- F#2 G2- F#2 E2- C#2 | E1- G#1 B1- C#2 D2- C#2 B1- B1 |
gtr   | A2+E3- A2+E3 A2+F#3- A2+F#3 A2+G3- A2+G3 A2+F#3- A2+F#3 | D3+A3- D3+A3 D3+B3- D3+B3 D3+C4- D3+C4 D3+B3- D3+B3 | A2+E3- A2+E3 A2+F#3- A2+F#3 A2+G3- A2+G3 A2+F#3- A2+F#3 | % |
gtr   | D3+A3- D3+A3 D3+B3- D3+B3 D3+C4- D3+C4 D3+B3- D3+B3 | % | A2+E3- A2+E3 A2+F#3- A2+F#3 A2+G3- A2+G3 A2+F#3- A2+F#3 | % |
gtr   | E2+B2- E2+B2 E2+C#3- E2+C#3 E2+D3- E2+D3 E2+C#3- E2+C#3 | D3+A3- D3+A3 D3+B3- D3+B3 D3+C4- D3+C4 D3+B3- D3+B3 | A2+E3- A2+E3 A2+F#3- A2+F#3 A2+G3- A2+G3 A2+F#3- A2+F#3 | E2+B2- E2+B2 E2+C#3- E2+C#3 E2+D3- E2+D3 E2+C#3- E2+C#3 |
keys  | .- C#4+G4+B4? C#4+G4+B4-- .- C#4+G4+B4? C#4+G4+B4-- | .- C4+F#4+A4? C4+F#4+A4-- .- C4+F#4+A4? C4+F#4+A4-- | .- C#4+G4+B4? C#4+G4+B4-- .- C#4+G4+B4? C#4+G4+B4-- | % |
keys  | .- C4+F#4+A4? C4+F#4+A4-- .- C4+F#4+A4? C4+F#4+A4-- | % | .- C#4+G4+B4? C#4+G4+B4-- .- C#4+G4+B4? C#4+G4+B4-- | % |
keys  | .- D4+G#4+B4? D4+G#4+B4-- .- D4+G#4+B4? D4+G#4+B4-- | .- C4+F#4+A4? C4+F#4+A4-- .- C4+F#4+A4? C4+F#4+A4-- | .- C#4+G4+B4? C#4+G4+B4-- .- C#4+G4+B4? C#4+G4+B4-- | .- D4+G#4+B4? D4+G#4+B4-- .- D4+G#4+B4? D4+G#4+B4-- |
ride  | x.x X.x x.x X.x | % | % | % |
ride  | % | % | % | % |
ride  | % | % | % | % |
hat   | ... x.. ... x.. | % | % | % |
hat   | % | % | % | % |
hat   | % | % | % | % |
snare | ... X.. ..o X.. | % | % | % |
snare | % | % | % | % |
snare | % | % | % | ... X.. xox XxX |
kick  | X.. ... x.. ... | % | % | % |
kick  | % | % | % | % |
kick  | % | % | % | X.. ... x.. ..x |
crash | X.. ... ... ... | _ | _ | _ |
crash | _ | _ | _ | _ |
crash | _ | _ | _ | _ |

# Ending: one bar, everyone hits A9 on the downbeat and lets it ring.
pattern ending
bass  | A1!----------- |
gtr   | A2+E3+G3+C#4!----------- |
keys  | A3+C#4+G4+B4!----------- |
kick  | X.. ... ... ... |
crash | X.. ... ... ... |

play chorus*2 ending
